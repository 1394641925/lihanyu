<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>小夏の便利店.net - 雨天的便利店</title>
    <style>
        /* ===== 全局重置 & 基础 ===== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            cursor: default;
            user-select: none;
        }
        body {
            background: #808080;
            font-family: '宋体', 'SimSun', 'Times New Roman', serif;
            font-size: 12px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            image-rendering: pixelated;
        }
        ::-webkit-scrollbar {
            width: 16px;
            background: #c0c0c0;
        }
        ::-webkit-scrollbar-track {
            background: #c0c0c0;
        }
        ::-webkit-scrollbar-thumb {
            background: #808080;
            border: 2px solid #dfdfdf;
            border-top-color: #404040;
            border-left-color: #404040;
        }
        ::-webkit-scrollbar-button {
            display: none;
        }

        /* ===== 主容器 ===== */
        #container {
            width: 780px;
            min-height: 500px;
            background: #c0c0c0;
            border: 3px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            box-shadow: 4px 4px 12px rgba(0, 0, 0, 0.5);
            position: relative;
            font-family: '宋体', 'SimSun', 'Times New Roman', serif;
            image-rendering: pixelated;
        }

        /* ===== 顶部横幅 ===== */
        #banner {
            height: 120px;
            background: #ffffff;
            border-bottom: 2px solid #808080;
            display: flex;
            align-items: center;
            padding: 6px 10px;
            gap: 8px;
            position: relative;
            overflow: hidden;
        }
        #banner-left {
            flex: 0 0 180px;
            text-align: center;
        }
        #logo {
            font-size: 26px;
            font-weight: bold;
            color: #ff00ff;
            text-shadow: 0 0 4px #ff00ff, 0 0 8px #ff00ff, 2px 2px 0 #000080;
            font-family: 'Comic Sans MS', '宋体', cursive;
            letter-spacing: 2px;
            image-rendering: pixelated;
            animation: logoBlink 0.8s infinite alternate;
            background: #000000;
            padding: 4px 8px;
            border: 2px solid #ff00ff;
            transform: skewX(-2deg);
        }
        @keyframes logoBlink {
            0% {
                opacity: 1;
                text-shadow: 0 0 4px #ff00ff, 0 0 8px #ff00ff, 2px 2px 0 #000080;
            }
            100% {
                opacity: 0.7;
                text-shadow: 0 0 2px #ff00ff, 0 0 4px #ff00ff, 2px 2px 0 #000080;
            }
        }
        #banner-mid {
            flex: 1;
            overflow: hidden;
            background: #000080;
            padding: 4px 0;
            border: 2px inset #808080;
            height: 36px;
            display: flex;
            align-items: center;
        }
        #marquee {
            color: #ffff00;
            font-size: 18px;
            font-weight: bold;
            white-space: nowrap;
            animation: marqueeScroll 12s linear infinite;
            text-shadow: 0 0 4px #ffff00;
            letter-spacing: 4px;
        }
        @keyframes marqueeScroll {
            0% {
                transform: translateX(100%);
            }
            100% {
                transform: translateX(-100%);
            }
        }
        #banner-right {
            flex: 0 0 120px;
            text-align: right;
            font-family: 'Courier New', monospace;
            font-size: 20px;
            font-weight: bold;
            color: #ff0000;
            background: #000000;
            padding: 4px 6px;
            border: 2px inset #808080;
            letter-spacing: 2px;
        }
        #counter {
            font-family: 'Courier New', monospace;
            font-size: 22px;
            color: #00ff00;
            background: #000000;
            padding: 2px 6px;
            display: inline-block;
            border: 1px solid #00ff00;
        }

        /* 广告横幅 */
        #ad-banner {
            position: absolute;
            top: 2px;
            right: 10px;
            background: #ffff00;
            color: #ff0000;
            font-size: 11px;
            font-weight: bold;
            padding: 2px 8px;
            border: 2px solid #ff0000;
            animation: adBlink 0.5s infinite alternate;
            cursor: pointer;
            z-index: 5;
            font-family: '宋体', sans-serif;
        }
        #ad-banner:hover {
            animation: adBlink 0.1s infinite alternate;
            cursor: pointer;
        }
        @keyframes adBlink {
            0% {
                opacity: 1;
                transform: scale(1);
            }
            100% {
                opacity: 0.3;
                transform: scale(0.98);
            }
        }

        /* ===== 导航栏 ===== */
        #navbar {
            height: 40px;
            background: #000080;
            display: flex;
            align-items: center;
            padding: 0 16px;
            border-bottom: 2px solid #808080;
            gap: 2px;
        }
        #navbar a {
            color: #ffffff;
            font-weight: bold;
            font-size: 14px;
            padding: 4px 14px;
            text-decoration: none;
            font-family: '宋体', 'SimSun', serif;
            border: 2px solid #000080;
            background: #000080;
            transition: none;
        }
        #navbar a:hover {
            background: #0000a0;
            border-color: #0000a0;
            color: #ffffff;
            text-decoration: none;
        }
        #navbar a.active {
            background: #0000c0;
            border: 2px inset #808080;
            border-top-color: #000080;
            border-left-color: #000080;
        }

        /* ===== 主体区域 ===== */
        #main {
            min-height: 320px;
            background: #c0c0c0;
            padding: 16px 20px;
            position: relative;
            background-image:
                linear-gradient(rgba(128, 128, 128, 0.1) 1px, transparent 1px),
                linear-gradient(90deg, rgba(128, 128, 128, 0.1) 1px, transparent 1px);
            background-size: 20px 20px;
            background-position: -1px -1px;
        }
        .page {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .page.active {
            display: block;
        }
        @keyframes fadeIn {
            0% {
                opacity: 0.3;
            }
            100% {
                opacity: 1;
            }
        }

        .page h2 {
            color: #000080;
            font-size: 18px;
            border-bottom: 2px solid #000080;
            padding-bottom: 6px;
            margin-bottom: 12px;
            font-family: '宋体', serif;
        }
        .page p {
            font-size: 14px;
            line-height: 1.8;
            color: #000000;
            margin-bottom: 8px;
            font-family: '宋体', serif;
        }
        .page a {
            color: #0000ff;
            text-decoration: underline;
            cursor: pointer;
        }
        .page a:visited {
            color: #800080;
        }
        .page a:hover {
            color: #0000ff;
            text-decoration: underline;
        }

        /* 日记本 */
        .diary-entry {
            background: #fffff0;
            border: 1px solid #808080;
            padding: 12px 16px;
            margin-bottom: 10px;
            font-family: '宋体', serif;
            font-size: 14px;
            line-height: 1.8;
            min-height: 100px;
        }
        .diary-entry .date {
            color: #000080;
            font-weight: bold;
            font-size: 13px;
            border-bottom: 1px dashed #808080;
            padding-bottom: 4px;
            margin-bottom: 8px;
        }
        .diary-nav {
            display: flex;
            gap: 12px;
            margin-top: 10px;
            justify-content: center;
        }
        .diary-nav button {
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 4px 18px;
            font-family: '宋体', serif;
            font-size: 13px;
            cursor: pointer;
            color: #000000;
        }
        .diary-nav button:hover {
            background: #d0d0d0;
        }
        .diary-nav button:active {
            border: 2px solid #808080;
            border-bottom-color: #dfdfdf;
            border-right-color: #dfdfdf;
        }

        /* 相册 */
        .photo-grid {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }
        .photo-item {
            border: 2px solid #808080;
            padding: 6px;
            background: #ffffff;
            text-align: center;
            width: 200px;
        }
        .photo-item img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            background: #e0e0e0;
            image-rendering: pixelated;
        }
        .photo-item .caption {
            font-size: 12px;
            color: #000000;
            margin-top: 4px;
            font-family: '宋体', serif;
        }

        /* 点唱机 */
        #player {
            background: #000000;
            padding: 16px;
            border: 2px inset #808080;
            margin: 8px 0;
        }
        #player .controls {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }
        #player button {
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 4px 14px;
            font-family: '宋体', serif;
            font-size: 13px;
            cursor: pointer;
            color: #000000;
        }
        #player button:active {
            border: 2px solid #808080;
            border-bottom-color: #dfdfdf;
            border-right-color: #dfdfdf;
        }
        #player .status {
            color: #00ff00;
            font-family: 'Courier New', monospace;
            font-size: 13px;
            margin-left: 10px;
        }
        #player .progress-bar {
            width: 100%;
            height: 18px;
            background: #404040;
            border: 2px inset #808080;
            margin-top: 8px;
            position: relative;
        }
        #player .progress-fill {
            height: 100%;
            background: #00ff00;
            width: 0%;
            transition: width 0.3s;
        }
        #player .progress-label {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            color: #ffffff;
            font-size: 11px;
            font-family: 'Courier New', monospace;
            line-height: 18px;
        }

        /* 留言板 */
        #guestbook-entries {
            max-height: 200px;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid #808080;
            padding: 8px 12px;
            margin-bottom: 10px;
            font-size: 13px;
            line-height: 1.6;
        }
        #guestbook-entries .gb-entry {
            border-bottom: 1px dashed #c0c0c0;
            padding: 4px 0;
        }
        #guestbook-entries .gb-entry .gb-name {
            color: #000080;
            font-weight: bold;
        }
        #guestbook-entries .gb-entry .gb-time {
            color: #808080;
            font-size: 11px;
            margin-left: 8px;
        }
        .gb-input-area {
            display: flex;
            gap: 8px;
            margin-top: 6px;
        }
        .gb-input-area input {
            flex: 1;
            padding: 4px 8px;
            border: 2px inset #808080;
            font-family: '宋体', serif;
            font-size: 13px;
            background: #ffffff;
            color: #000000;
        }
        .gb-input-area button {
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 4px 16px;
            font-family: '宋体', serif;
            font-size: 13px;
            cursor: pointer;
        }
        .gb-input-area button:active {
            border: 2px solid #808080;
            border-bottom-color: #dfdfdf;
            border-right-color: #dfdfdf;
        }

        /* 友链 */
        .link-list {
            list-style: none;
            padding: 0;
        }
        .link-list li {
            padding: 4px 0;
            border-bottom: 1px dashed #808080;
            font-size: 14px;
        }
        .link-list li a {
            color: #0000ff;
            text-decoration: underline;
            cursor: pointer;
        }

        /* ===== 底部状态栏 ===== */
        #statusbar {
            height: 25px;
            background: #c0c0c0;
            border-top: 2px solid #dfdfdf;
            display: flex;
            align-items: center;
            padding: 0 12px;
            font-size: 12px;
            font-family: '宋体', serif;
            color: #000000;
            justify-content: space-between;
        }
        #statusbar .left {
            display: flex;
            align-items: center;
            gap: 12px;
        }
        #statusbar .left .status-icon {
            width: 16px;
            height: 16px;
            background: #00ff00;
            border: 1px solid #808080;
            display: inline-block;
        }
        #statusbar .right {
            font-family: 'Courier New', monospace;
            font-size: 12px;
            cursor: pointer;
        }

        /* ===== 进度条（加载） ===== */
        #progress-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            backdrop-filter: blur(2px);
        }
        #progress-overlay.show {
            display: flex;
        }
        #progress-box {
            background: #c0c0c0;
            border: 3px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 24px 40px;
            min-width: 300px;
            text-align: center;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.6);
        }
        #progress-box .label {
            font-size: 14px;
            color: #000000;
            margin-bottom: 8px;
            font-family: '宋体', serif;
        }
        #progress-box .track {
            width: 100%;
            height: 20px;
            background: #ffffff;
            border: 2px inset #808080;
            position: relative;
        }
        #progress-box .fill {
            height: 100%;
            background: #000080;
            width: 0%;
            transition: width 0.15s;
        }
        #progress-box .percent {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            font-size: 12px;
            line-height: 20px;
            color: #ffffff;
            font-family: 'Courier New', monospace;
        }

        /* ===== 弹窗系统 ===== */
        #modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 10000;
        }
        #modal-overlay.show {
            display: flex;
        }
        #modal-box {
            background: #c0c0c0;
            border: 3px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            min-width: 380px;
            max-width: 480px;
            box-shadow: 4px 4px 20px rgba(0, 0, 0, 0.7);
            font-family: '宋体', serif;
            position: relative;
        }
        #modal-titlebar {
            background: #000080;
            color: #ffffff;
            padding: 4px 10px;
            font-size: 13px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: default;
            font-family: '宋体', serif;
        }
        #modal-titlebar .btns {
            display: flex;
            gap: 4px;
        }
        #modal-titlebar .btns span {
            display: inline-block;
            width: 18px;
            height: 18px;
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            text-align: center;
            line-height: 16px;
            font-size: 12px;
            color: #000000;
            cursor: pointer;
            font-family: '宋体', serif;
        }
        #modal-titlebar .btns span:active {
            border: 2px solid #808080;
            border-bottom-color: #dfdfdf;
            border-right-color: #dfdfdf;
        }
        #modal-body {
            padding: 20px 24px 16px;
            font-size: 14px;
            color: #000000;
            line-height: 1.6;
            min-height: 80px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        #modal-body .modal-icon {
            font-size: 32px;
            margin-bottom: 8px;
        }
        #modal-body .modal-text {
            text-align: center;
        }
        #modal-body .modal-btns {
            display: flex;
            gap: 16px;
            margin-top: 16px;
            justify-content: center;
        }
        #modal-body .modal-btns button {
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 4px 24px;
            font-size: 13px;
            font-family: '宋体', serif;
            cursor: pointer;
            min-width: 60px;
        }
        #modal-body .modal-btns button:active {
            border: 2px solid #808080;
            border-bottom-color: #dfdfdf;
            border-right-color: #dfdfdf;
        }
        #modal-body .modal-flash {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.05s;
            background: rgba(0, 0, 0, 0.8);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
        }
        #modal-body .modal-flash img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            image-rendering: pixelated;
            filter: grayscale(1) contrast(2);
        }
        #modal-body .modal-flash.active {
            opacity: 1;
        }

        /* ===== 自定义右键菜单 ===== */
        #context-menu {
            position: fixed;
            background: #c0c0c0;
            border: 2px solid #dfdfdf;
            border-top-color: #ffffff;
            border-left-color: #ffffff;
            padding: 2px 0;
            min-width: 180px;
            display: none;
            z-index: 20000;
            box-shadow: 2px 2px 8px rgba(0, 0, 0, 0.4);
            font-family: '宋体', serif;
            font-size: 13px;
        }
        #context-menu .item {
            padding: 4px 24px 4px 18px;
            cursor: pointer;
            color: #000000;
        }
        #context-menu .item:hover {
            background: #000080;
            color: #ffffff;
        }
        #context-menu .sep {
            height: 1px;
            background: #808080;
            margin: 2px 8px;
        }

        /* ===== 右下角女孩GIF ===== */
        #girl-gif {
            position: fixed;
            bottom: 30px;
            right: 20px;
            width: 80px;
            height: 120px;
            z-index: 100;
            pointer-events: none;
            image-rendering: pixelated;
            opacity: 0.9;
            transition: opacity 0.5s;
        }
        #girl-gif canvas {
            width: 100%;
            height: 100%;
            image-rendering: pixelated;
        }

        /* ===== CMD彩蛋 ===== */
        #cmd-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.8);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 30000;
        }
        #cmd-overlay.show {
            display: flex;
        }
        #cmd-box {
            background: #000000;
            color: #00ff00;
            font-family: 'Courier New', monospace;
            font-size: 15px;
            padding: 30px 40px;
            min-width: 500px;
            min-height: 220px;
            border: 2px solid #00ff00;
            box-shadow: 0 0 30px rgba(0, 255, 0, 0.2);
            line-height: 1.8;
            white-space: pre-wrap;
        }
        #cmd-box .blink {
            animation: cmdBlink 0.8s infinite;
        }
        @keyframes cmdBlink {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0;
            }
        }

        /* ===== 终局粒子 ===== */
        #particle-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 50000;
            pointer-events: none;
            display: none;
        }
        #particle-canvas.show {
            display: block;
        }

        /* ===== 404 终局 ===== */
        #final-404 {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #ffffff;
            z-index: 60000;
            justify-content: center;
            align-items: center;
            flex-direction: column;
            font-family: '宋体', serif;
            font-size: 24px;
            color: #000000;
        }
        #final-404.show {
            display: flex;
        }
        #final-404 h1 {
            font-size: 48px;
            color: #808080;
            margin-bottom: 16px;
        }
        #final-404 p {
            font-size: 16px;
            color: #404040;
        }

        /* ===== 颜色反转模式 ===== */
        body.inverted #container {
            filter: invert(1) hue-rotate(180deg);
            background: #000000;
        }
        body.inverted #container * {
            filter: invert(1) hue-rotate(180deg);
        }
        body.inverted #container img {
            filter: invert(1) hue-rotate(180deg);
        }
        body.inverted #girl-gif {
            filter: invert(1) hue-rotate(180deg);
        }

        /* ===== 通用工具 ===== */
        .hidden {
            display: none !important;
        }
        .text-center {
            text-align: center;
        }
        .mt-8 {
            margin-top: 8px;
        }
        .mb-8 {
            margin-bottom: 8px;
        }
        .text-red {
            color: #ff0000;
        }
        .text-blue {
            color: #0000ff;
        }
        .text-yellow {
            color: #ffff00;
        }

        /* ===== 响应式 ===== */
        @media (max-width: 820px) {
            #container {
                width: 100%;
                min-width: 320px;
            }
            #banner {
                flex-wrap: wrap;
                height: auto;
                min-height: 100px;
                padding: 6px;
            }
            #banner-left {
                flex: 1 1 100%;
                text-align: center;
            }
            #banner-mid {
                flex: 1 1 100%;
                height: 30px;
            }
            #banner-right {
                flex: 1 1 100%;
                text-align: center;
            }
            #navbar {
                flex-wrap: wrap;
                height: auto;
                padding: 4px 8px;
                gap: 0;
            }
            #navbar a {
                font-size: 12px;
                padding: 4px 8px;
                flex: 1 0 auto;
                text-align: center;
            }
            #main {
                padding: 10px 12px;
            }
            .photo-grid {
                flex-direction: column;
                align-items: center;
            }
            .photo-item {
