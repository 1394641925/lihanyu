        // ---------- 粒子溶解 ----------
        function startParticleDissolve() {
            const canvas = particleCanvas;
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            canvas.classList.add('show');

            // 截图当前页面
            const main = document.getElementById('main');
            // 使用canvas绘制当前内容
            const tempCanvas = document.createElement('canvas');
            const tempCtx = tempCanvas.getContext('2d');
            tempCanvas.width = main.scrollWidth;
            tempCanvas.height = main.scrollHeight;
            tempCtx.fillStyle = '#000000';
            tempCtx.fillRect(0, 0, tempCanvas.width, tempCanvas.height);
            // 绘制主内容
            const mainClone = main.cloneNode(true);
            mainClone.style.position = 'absolute';
            mainClone.style.top = '0';
            mainClone.style.left = '0';
            mainClone.style.width = tempCanvas.width + 'px';
            mainClone.style.height = tempCanvas.height + 'px';
            mainClone.style.background = '#000000';
            mainClone.style.color = '#ffffff';
            mainClone.style.padding = '20px';
            mainClone.style.boxSizing = 'border-box';
            mainClone.style.overflow = 'hidden';
            document.body.appendChild(mainClone);
            // 绘制到canvas
            // 简化：直接用文字绘制
            tempCtx.fillStyle = '#ffffff';
            tempCtx.font = '24px 宋体, serif';
            tempCtx.textAlign = 'center';
            tempCtx.fillText('谢谢你，解开了我的雨。', tempCanvas.width / 2, tempCanvas.height / 2 - 20);

            // 粒子系统
            const particles = [];
            const imageData = tempCtx.getImageData(0, 0, tempCanvas.width, tempCanvas.height);
            const data = imageData.data;
            const w = tempCanvas.width;
            const h = tempCanvas.height;

            // 采样像素
            const step = 4;
            for (let y = 0; y < h; y += step) {
                for (let x = 0; x < w; x += step) {
                    const idx = (y * w + x) * 4;
                    const r = data[idx];
                    const g = data[idx + 1];
                    const b = data[idx + 2];
                    const a = data[idx + 3];
                    if (a > 30 && (r > 50 || g > 50 || b > 50)) {
                        particles.push({
                            x: x,
                            y: y,
                            originX: x,
                            originY: y,
                            r: r,
                            g: g,
                            b: b,
                            vx: (Math.random() - 0.5) * 2,
                            vy: (Math.random() - 0.5) * 2 - 1,
                            life: 1,
                            decay: 0.005 + Math.random() * 0.015
                        });
                    }
                }
            }

            // 限制粒子数量
            const maxParticles = 3000;
            if (particles.length > maxParticles) {
                particles.splice(maxParticles);
            }

            let frameId = null;

            function dissolve() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                let alive = false;
                for (const p of particles) {
                    if (p.life <= 0) continue;
                    p.x += p.vx;
                    p.y += p.vy;
                    p.vy += 0.05;
                    p.vx *= 0.99;
                    p.vy *= 0.99;
                    p.life -= p.decay;
                    if (p.life > 0) {
                        alive = true;
                        const alpha = p.life * 255;
                        ctx.fillStyle = `rgba(${p.r},${p.g},${p.b},${Math.min(1,p.life)})`;
                        ctx.fillRect(p.x, p.y, 2, 2);
                    }
                }
                if (alive) {
                    frameId = requestAnimationFrame(dissolve);
                } else {
                    // 完成
                    canvas.classList.remove('show');
                    showFinalText();
                }
            }

            // 移除克隆
            document.body.removeChild(mainClone);
            dissolve();

            // 播放完整音乐
            setTimeout(() => {
                stopMusic();
                // 播放清晰版
                setTimeout(() => {
                    playMusic();
                    // 设置音质清晰
                    if (Game.musicGain) {
                        Game.musicGain.gain.value = 0.4;
                    }
                }, 200);
            }, 500);
        }

