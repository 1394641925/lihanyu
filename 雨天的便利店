        diaryNext.addEventListener('click', diaryNextPage);
        diaryPrev.addEventListener('click', diaryPrevPage);

        // ---------- 音乐事件 ----------
        playBtn.addEventListener('click', () => {
            initAudio();
            playMusic();
        });
        pauseBtn.addEventListener('click', pauseMusic);
        stopBtn.addEventListener('click', stopMusic);

        // ---------- 留言板事件 ----------
        gbSubmit.addEventListener('click', submitGuestMessage);
        gbInput.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                submitGuestMessage();
            }
        });

        // ---------- 模态框关闭按钮 ----------
        modalClose.addEventListener('click', closeModal);
        modalBtnOk.addEventListener('click', () => {
            closeModal();
        });
        modalBtnCancel.addEventListener('click', () => {
            closeModal();
        });

        // ---------- 初始化 ----------
        function init() {
            // 尝试从localStorage恢复
            try {
                const saved = localStorage.getItem(Game.SAVE_KEY);
                if (saved) {
                    const data = JSON.parse(saved);
                    Object.assign(Game, data);
                    // 恢复UI状态
                    if (Game.phase >= 1) {
                        statusText.textContent = '⚠️ 数据异常';
                        if (Game.phase >= 2) {
                            statusText.textContent = '⚠️ 侵入进行中';
                        }
                        if (Game.phase >= 3) {
                            statusText.textContent = '⚠️ 服务器崩溃中...';
                        }
                        if (Game.phase >= 4) {
                            statusText.textContent = '📄 重组数据中...';
                        }
                        if (Game.phase >= 5) {
                            statusText.textContent = '完成，但故事还在继续。';
                        }
                    }
                    if (Game.isInverted) {
                        document.body.classList.add('inverted');
                    }
                    renderDiary();
                    updateCounter();
                    if (Game.photoCorrupt > 0) {
                        corruptPhoto();
                    }
                    // 恢复留言
                    if (Game.guestMessages.length > 0) {
                        // 重绘留言
                        const entries = gbEntries;
                        // 保留初始5条
                        const initial = entries.querySelectorAll('.gb-entry');
                        // 只保留前5条
                        while (entries.children.length > 5) {
                            entries.removeChild(entries.lastChild);
                        }
                        // 添加保存的留言
                        for (const msg of Game.guestMessages) {
                            const div = document.createElement('div');
                            div.className = 'gb-entry';
                            div.innerHTML =
                                `<span class="gb-name">🌙 访客</span><span class="gb-time">${msg.time}</span><br>${msg.text}`;
                            entries.appendChild(div);
                        }
                    }
                    if (Game.hasSeenAdmin) {
                        // 检查是否已有Admin留言
                        let hasAdmin = false;
                        for (const child of gbEntries.children) {
                            if (child.textContent.includes('Admin')) {
                                hasAdmin = true;
                                break;
                            }
                        }
                        if (!hasAdmin) {
                            addAdminMessage();
                        }
                    }
                    if (Game.puzzleSolved) {
                        // 进入终局
                        Game.phase = 5;
                        triggerFinale();
                    }
                }
            } catch (e) {}

            // 启动定时器
            setInterval(updateCounter, 3000);
            setInterval(updateStatusTime, 1000);
            // 计数器初始更新
            updateCounter();

            // 初始化女孩
            initGirl();

            // 自动播放音乐
            setTimeout(() => {
                initAudio();
                playMusic();
            }, 500);

            // 更新访问量
            visitMsg.textContent = `📅 今日访问：${Math.floor(Math.random() * 20 + 1)} 人`;

            // 检查阶段
            if (Game.phase === 0) {
                statusText.textContent = '完成';
                // 阶段0恐怖植入：状态栏时间卡住
                statusTime.textContent = '2003/07/14 17:23:05';
            }

            // 保存游戏状态
            setInterval(() => {
                try {
                    localStorage.setItem(Game.SAVE_KEY, JSON.stringify(Game));
                } catch (e) {}
            }, 10000);

            console.log('☔ 欢迎来到小夏的便利店');
            console.log('📖 这是一场迟到了20年的告别。');
            console.log('💡 提示：查看源代码 (Ctrl+U) 或许能找到线索。');
        }

        // 启动游戏
        document.addEventListener('DOMContentLoaded', init);
    </script>
</body>
</html>
