            // 填充音频数据
            for (let i = 0; i < data.length; i++) {
                let val = 0;
                const t = i / sampleRate;
                for (const n of notes) {
                    const [freq, start, dur] = n;
                    if (t >= start && t < start + dur) {
                        const env = Math.sin((t - start) / dur * Math.PI) * 0.6;
                        val += Math.sin(t * freq * 2 * Math.PI) * env * 0.25;
                    }
                }
                // 添加一点混响感
                val += (Math.random() - 0.5) * 0.01;
                data[i] = Math.max(-1, Math.min(1, val * 0.6));
            }

            Game.musicBuffer = buffer;
        }

        function playMusic() {
            if (!Game.musicCtx) initAudio();
            if (!Game.musicBuffer) return;
            const ctx = Game.musicCtx;
            if (ctx.state === 'suspended') {
                ctx.resume();
            }
            if (Game.musicSource) {
                try { Game.musicSource.stop(); } catch (e) {}
            }
            Game.musicSource = ctx.createBufferSource();
            Game.musicSource.buffer = Game.musicBuffer;
            Game.musicSource.loop = true;
            Game.musicSource.connect(Game.musicGain);
            Game.musicSource.start(0);
            Game.musicStarted = true;
            Game.musicPaused = false;
            musicStatus.textContent = '● 播放中';
            musicStatus.style.color = '#00ff00';
            updateMusicProgress();
        }

        function pauseMusic() {
            if (Game.musicSource && Game.musicStarted) {
                try {
                    Game.musicSource.stop();
                    Game.musicPaused = true;
                    musicStatus.textContent = '⏸ 已暂停';
                    musicStatus.style.color = '#ffff00';
